{
  "name": "history-in-a-week",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "questions:check": "npm run questions:index --silent && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-questions.mts",
    "check": "bash scripts/check.sh",
    "questions:index": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-bank-index.mts",
    "predev": "npm run questions:index --silent",
    "prebuild": "npm run questions:index --silent",
    "test:db": "bash scripts/test-db.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
